// orbit-gitops#10: 클러스터 메트릭·로그를 모니터링 VM(192.168.100.107)의 Prometheus·Loki로 전송한다.
// 서버 메트릭 포트(8080)·경로(/actuator/prometheus)는 orbit docs/phase1.md 공통 값 표 기준 "미확정" 값이다.
// 확정되면 이 파일의 orbit_server 관련 블록을 갱신한다.
//
// Alloy는 DaemonSet(노드마다 1개, 현재 3 replica)이라 동일 config가 그대로 복제 실행된다.
// orbit-server Pod·kubelet/cAdvisor·orbit namespace 로그처럼 "노드별로 존재하는" target을
// 노드 범위 없이 discovery.kubernetes로만 찾으면 3개 replica가 전부 같은 대상을 중복
// scrape·tail해 Prometheus에 duplicate/out-of-order sample 에러가 계속 발생한다
// (실측: 머지 직후 모든 Alloy pod 로그에서 지속 확인됨). 아래에서는 각 replica가 자기
// 노드(chart가 기본으로 주입하는 K8S_NODE_NAME env) 몫만 담당하도록 discovery.relabel에
// keep 규칙을 추가한다. kube-state-metrics는 노드별 target이 아니라 고정 단일 target이라
// 이 방식이 적용되지 않으므로, 그 scrape는 대신 Alloy clustering으로 cluster peer 중
// 하나만 scrape하도록 분리했다(해당 블록 주석 참조).

logging {
	level  = "info"
	format = "logfmt"
}

// ---------- 메트릭: orbit-server Pod ----------

discovery.kubernetes "orbit_server_pods" {
	role = "pod"

	namespaces {
		names = ["orbit"]
	}

	selectors {
		role  = "pod"
		label = "app=orbit-server"
	}
}

discovery.relabel "orbit_server_targets" {
	targets = discovery.kubernetes.orbit_server_pods.targets

	rule {
		source_labels = ["__meta_kubernetes_pod_ip"]
		target_label  = "__address__"
		replacement   = "$1:8080"
	}

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app"]
		target_label  = "app"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	// 이 Pod가 뜬 노드와 이 Alloy replica의 노드(env K8S_NODE_NAME)가 같을 때만 남긴다.
	// orbit-server Pod는 노드마다 있을 수 있는 target이라 replica별로 자기 노드 몫만
	// scrape하면 전체 replica를 합쳐 중복 없이 전부 커버된다.
	rule {
		source_labels = ["__meta_kubernetes_pod_node_name"]
		regex         = env("K8S_NODE_NAME")
		action        = "keep"
	}
}

prometheus.scrape "orbit_server" {
	targets         = discovery.relabel.orbit_server_targets.output
	metrics_path    = "/actuator/prometheus"
	scrape_interval = "30s"
	forward_to      = [prometheus.relabel.limit_labels.receiver]
}

// ---------- 메트릭: kubelet·cAdvisor (노드) ----------
// kubelet serving 인증서는 kubeadm 자체 서명이라 공용 CA로 검증되지 않는다.
// 모니터링 전용 수집(클러스터 내부 접근)이라 insecure_skip_verify로 처리한다.
// CA 배포로 전환할 경우 orbit-infrastructure 쪽에 kubelet-serving-ca ConfigMap 배포가 선행돼야 한다.

discovery.kubernetes "nodes" {
	role = "node"
}

discovery.relabel "kubelet_targets" {
	targets = discovery.kubernetes.nodes.targets

	rule {
		source_labels = ["__meta_kubernetes_node_address_InternalIP"]
		target_label  = "__address__"
		replacement   = "$1:10250"
	}

	rule {
		source_labels = ["__meta_kubernetes_node_name"]
		target_label  = "node"
	}

	// discovery.kubernetes(role=node)는 클러스터의 모든 노드를 반환한다. 이 replica의
	// 노드(env K8S_NODE_NAME)와 다른 노드는 버려서 각 replica가 자기 노드의 kubelet만
	// scrape하게 한다 — 안 그러면 replica 3개가 노드 3개를 전부 중복 scrape한다.
	rule {
		source_labels = ["__meta_kubernetes_node_name"]
		regex         = env("K8S_NODE_NAME")
		action        = "keep"
	}
}

prometheus.scrape "kubelet_cadvisor" {
	targets            = discovery.relabel.kubelet_targets.output
	scheme             = "https"
	metrics_path       = "/metrics/cadvisor"
	bearer_token_file  = "/var/run/secrets/kubernetes.io/serviceaccount/token"
	scrape_interval    = "30s"
	forward_to         = [prometheus.relabel.cadvisor_select.receiver]

	tls_config {
		insecure_skip_verify = true
	}
}

// ---------- 메트릭: kube-state-metrics ----------
// 동일 네임스페이스 Service(fixed DNS)를 고정 대상으로 scrape한다. K8s SD는 쓰지 않는다.
//
// 이 target은 노드별이 아니라 단일 고정 주소라 orbit_server·kubelet처럼 K8S_NODE_NAME
// keep 규칙으로 나눌 수 없다 — 그대로 두면 replica 3개가 똑같은 target을 scrape해
// 동일 시계열을 3번 remote_write하게 된다. clustering { enabled = true }를 걸면
// (values.yaml의 alloy.clustering.enabled: true로 cluster peer 탐색이 켜져 있어야
// 함) Alloy가 cluster peer 사이에서 target을 일관 해싱으로 나눠, replica 3개 중
// 정확히 1개만 이 target을 실제로 scrape한다.
prometheus.scrape "kube_state_metrics" {
	targets = [{
		__address__ = "kube-state-metrics.observability.svc.cluster.local:8080",
	}]
	scrape_interval = "30s"
	forward_to      = [prometheus.relabel.limit_labels.receiver]

	clustering {
		enabled = true
	}
}

// ---------- cAdvisor 시계열 선별 ----------
// cAdvisor는 Pod·컨테이너 단위 지표 외에 블록 디바이스별(container_fs_*,
// container_blkio_*), 네트워크 인터페이스별(container_network_*), cgroup 계층별
// 롤업 시계열을 노드당 수백 개 내보낸다. 이들을 서로 구분하는 label은
// device·id·interface·name·image·failure_type·scope인데, 아래 limit_labels의
// labelkeep이 전부 지운다. 그러면 서로 다른 시계열이 동일한 label set으로 붕괴해
// 한 scrape 안에 같은 (시계열, timestamp) 샘플이 여러 개 생기고, Prometheus가
// "duplicate sample for timestamp" 400으로 거부한다.
//
// Prometheus 2.45는 이 soft error에서 appender를 Rollback하므로 **write 요청 전체**가
// 버려진다 — 같은 배치에 실려 간 정상 샘플까지 함께 사라져서, 특정 노드의 cAdvisor
// 지표가 통째로 비는 것처럼 보인다(orbit-gitops#35). 측정값: 노드당 붕괴 그룹
// 194~252개, 거부 추정 샘플 945~1134개.
//
// 그래서 orbit-observability#6 대시보드가 실제로 쓰는 지표만 남긴다. 와일드카드
// (container_cpu_.*·container_memory_.*)를 쓰지 않고 이름을 명시하는 이유는
// container_memory_failures_total처럼 같은 접두사를 쓰면서 failure_type·scope로만
// 구분되는 지표가 섞여 들어와 같은 붕괴를 다시 일으키기 때문이다.
// 새 패널이 다른 cAdvisor 지표를 쓰게 되면 그 지표가 Pod·컨테이너 단위로 유일한지
// 확인하고 이 목록에 추가한다.
prometheus.relabel "cadvisor_select" {
	forward_to = [prometheus.relabel.limit_labels.receiver]

	// Pod 단위가 아닌 cgroup·노드 전체 롤업(pod label이 비어 있음)을 버린다.
	// 이들은 id로만 구분되므로 labelkeep 후 반드시 충돌한다.
	rule {
		source_labels = ["pod"]
		regex         = ""
		action        = "drop"
	}

	rule {
		source_labels = ["__name__"]
		regex         = "container_cpu_usage_seconds_total|container_cpu_cfs_periods_total|container_cpu_cfs_throttled_periods_total|container_memory_working_set_bytes"
		action        = "keep"
	}
}

// label은 namespace·app·pod·node 수준으로 제한한다(차량 ID·토큰 등을 label로 쓰지 않음).
// 아래 추가 label은 orbit-observability#6 대시보드가 실제로 구분해야 하는 값들이다.
// 이게 없으면 같은 namespace의 서로 다른 시계열이 하나로 합쳐져 패널이 틀린 값을 낸다:
//   - deployment: kube_deployment_* — orbit-server·origin·edge Deployment 3개를 구분
//   - container, resource, unit: kube_pod_container_resource_requests/limits — CPU/메모리
//     request·limit이 같은 시계열로 충돌하는 걸 막음 (container는 cAdvisor 다중 컨테이너 Pod 구분에도 쓰임)
//   - phase: kube_pod_status_phase — Pod 상태별 구분
//   - qos_class: kube_pod_status_qos_class — Pod 하나당 guaranteed/burstable/besteffort
//     3개 시계열이 qos_class로만 구분된다. 지우면 붕괴해 400을 유발한다(orbit-gitops#35).
//   - metric_name, metric_target_type, horizontalpodautoscaler: kube_horizontalpodautoscaler_* — HPA 이름과
//     어떤 지표를 보는지 구분
//   - condition: kube_deployment_status_condition·kube_pod_status_ready — Available/Progressing,
//     Pod Ready 여부(true/false/unknown) 구분
//   - area: jvm_memory_used_bytes — heap/nonheap 구분
//   - le, method, status, outcome: http_server_requests_seconds_bucket — le 없이는
//     histogram_quantile 자체가 불가능하고(API P95 패널), method·status·outcome 없이는 오류율을 구분할 수 없음
prometheus.relabel "limit_labels" {
	forward_to = [prometheus.remote_write.monitoring_vm.receiver]

	rule {
		action = "labelkeep"
		regex  = "__name__|namespace|app|pod|node|job|instance|deployment|container|resource|unit|phase|qos_class|metric_name|metric_target_type|horizontalpodautoscaler|condition|area|le|method|status|outcome"
	}
}

prometheus.remote_write "monitoring_vm" {
	endpoint {
		url = "http://192.168.100.107:9090/api/v1/write"
	}
}

// ---------- 로그: orbit namespace Pod stdout ----------

discovery.kubernetes "orbit_pods" {
	role = "pod"

	namespaces {
		names = ["orbit"]
	}
}

// orbit_server_targets와 같은 이유로 노드 범위를 제한한다: discovery.kubernetes는
// namespace 안의 모든 노드에 걸친 Pod를 반환하므로, 이 필터가 없으면 replica 3개가
// 같은 Pod의 로그를 3번씩 중복 tail·push한다(실제 트래픽이 들어오면 Loki 쪽에서도
// "duplicate"/"entry out of order" push 거부가 발생할 수 있다).
discovery.relabel "orbit_logs_local_only" {
	targets = discovery.kubernetes.orbit_pods.targets

	// orbit-gitops#33: orbit_server_targets와 달리 이 블록에 __meta_kubernetes_*를
	// 실제 라벨로 승격하는 rule이 없어서, 아래 loki.process의 stage.label_keep이
	// 지킬 라벨이 하나도 없는 채로 로그가 Loki에 전송됐다(라벨 없는 스트림은 Loki가
	// service_name=unknown_service로 받아줘서 전송 자체는 성공하지만 namespace/pod
	// 라벨로는 조회가 불가능했다 — 실측 확인됨).
	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app"]
		target_label  = "app"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_node_name"]
		regex         = env("K8S_NODE_NAME")
		action        = "keep"
	}
}

loki.source.kubernetes "orbit_logs" {
	targets    = discovery.relabel.orbit_logs_local_only.output
	forward_to = [loki.process.limit_labels.receiver]
}

loki.process "limit_labels" {
	forward_to = [loki.write.monitoring_vm.receiver]

	// orbit-gitops#31: loki.source.kubernetes는 K8s log stream이 재연결될 때마다
	// 컨테이너 시작 시점부터 다시 읽어서 보낸다(읽은 위치를 유지하지 못함 — Alloy
	// 자체에 이 동작을 바꾸는 옵션이 없음, 공식 레퍼런스 확인됨). 그렇게 다시 읽은
	// 오래된 줄들이 모니터링 VM Loki의 "entry too far behind"(reject_old_samples)
	// 기준을 넘기면 Loki가 그 배치를 통째로 400으로 거부하고, Alloy는 재시도 없이
	// 배치 전체(최근에 새로 생긴 줄까지 포함)를 drop한다 — 그래서 로그가 한 줄도
	// 안 들어오는 상태가 계속 재발했다(실측: cdn-edge·orbit-server 모두 동일 증상).
	// 오래된 줄을 여기서 먼저 걸러내면 같은 배치에 묶여 같이 버려지던 최신 줄은
	// 살아서 push된다. 30m은 Loki 쪽 허용 범위(실측상 1~1.5h)보다 충분히 짧게 잡은
	// 값이라, 여기서 걸러지지 않고 넘어간 줄은 Loki에서도 거부되지 않는다.
	stage.drop {
		older_than          = "30m"
		drop_counter_reason = "orbit-gitops#31: loki reject_old_samples 회피"
	}

	stage.label_keep {
		values = ["namespace", "app", "pod", "container"]
	}
}

loki.write "monitoring_vm" {
	endpoint {
		url = "http://192.168.100.107:3100/loki/api/v1/push"
	}
}
